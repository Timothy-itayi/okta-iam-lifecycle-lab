#!/usr/bin/env node
// Access review of Rostr users. Export one CSV per manager, then apply Keep/Revoke.
// Revoke removes APP-Rostr-Users and APP-Rostr-Admins. It does not unassign the app
// (svc-jml-sync has no apps.manage) and it does not touch DEPT- groups.
// Auth is svc-jml-sync, DPoP required. See docs/decisions/scripts-identity.md.

const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');
const entitlements = require('./entitlements');
const { loadEnvFile } = require('./hr-sync');

const TICKET = /^REQ-\d{4}$/;
const HEADER = [
  'login',
  'department',
  'manager',
  'groups',
  'assignmentSource',
  'lastRostrSignIn',
  'decision',
];
const REVOKE_GROUPS = ['APP-Rostr-Users', 'APP-Rostr-Admins'];
const ROSTR_SAML_APP_ID = '0oa18eddmjpNG4dNI698';
const ROSTR_OIDC_APP_ID = '0oa18egjva6o5FpoP698';
const LOOKBACK_DAYS = 30;

function parseTicket(value) {
  if (typeof value !== 'string' || !TICKET.test(value)) {
    throw new Error('Ticket must match REQ-####');
  }
  return value;
}

function parseArgs(argv) {
  if (!argv.length) throw new Error('Pass export or apply');
  const command = argv[0];
  if (command !== 'export' && command !== 'apply') {
    throw new Error('Pass export or apply');
  }
  let out = null;
  let input = null;
  let ticket = null;
  let apply = false;
  for (let index = 1; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--out') {
      out = argv[index + 1];
      index += 1;
    } else if (arg === '--in') {
      input = argv[index + 1];
      index += 1;
    } else if (arg === '--ticket') {
      ticket = argv[index + 1];
      index += 1;
    } else if (arg === '--apply') {
      apply = true;
    } else {
      throw new Error(`Unknown argument ${arg}`);
    }
  }
  if (command === 'export') {
    if (!out) throw new Error('Pass --out <dir>');
    return { command, out };
  }
  if (!input) throw new Error('Pass --in <dir>');
  return { command, in: input, ticket: parseTicket(ticket), apply };
}

function csvCell(value) {
  const text = String(value ?? '');
  if (/[",\n]/.test(text)) return `"${text.replace(/"/g, '""')}"`;
  return text;
}

function toCsv(rows) {
  const lines = [HEADER.join(',')];
  for (const row of rows) {
    lines.push(HEADER.map((key) => csvCell(row[key])).join(','));
  }
  return `${lines.join('\n')}\n`;
}

function parseCsvLine(line) {
  const cells = [];
  let current = '';
  let quoted = false;
  for (let index = 0; index < line.length; index += 1) {
    const char = line[index];
    if (quoted) {
      if (char === '"') {
        if (line[index + 1] === '"') {
          current += '"';
          index += 1;
        } else {
          quoted = false;
        }
      } else {
        current += char;
      }
    } else if (char === '"') {
      quoted = true;
    } else if (char === ',') {
      cells.push(current);
      current = '';
    } else {
      current += char;
    }
  }
  cells.push(current);
  return cells;
}

function parseCsv(text) {
  const lines = String(text).replace(/^\uFEFF/, '').split(/\r?\n/).filter((line) => line.trim() !== '');
  if (!lines.length) throw new Error('CSV is empty');
  const header = parseCsvLine(lines[0]);
  if (header.join(',') !== HEADER.join(',')) {
    throw new Error(`CSV header must be ${HEADER.join(',')}`);
  }
  return lines.slice(1).map((line, index) => {
    const cells = parseCsvLine(line);
    if (cells.length !== HEADER.length) {
      throw new Error(`CSV row ${index + 2} has ${cells.length} columns, expected ${HEADER.length}`);
    }
    const row = {};
    HEADER.forEach((key, column) => {
      row[key] = cells[column];
    });
    return row;
  });
}

function parseDecision(value, login) {
  const decision = String(value || '').trim();
  if (decision === 'Keep' || decision === 'Revoke') return decision;
  throw new Error(`${login || 'row'} has no Keep/Revoke decision`);
}

function managerEmail(employee, byId) {
  if (!employee || !employee.managerId) return '';
  const manager = byId.get(employee.managerId);
  return manager && manager.email ? manager.email : '';
}

function packKey(employee) {
  if (!employee) return 'unmanaged';
  if (!employee.managerId) return 'no-manager';
  return 'managed';
}

function fileForRow(row) {
  if (row.pack === 'unmanaged') return 'unmanaged.csv';
  if (row.pack === 'no-manager' || !row.manager) return 'no-manager.csv';
  const local = String(row.manager).split('@')[0].toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  return `${local}.csv`;
}

function splitByManager(rows) {
  const packs = new Map();
  for (const row of rows) {
    const file = fileForRow(row);
    if (!packs.has(file)) packs.set(file, []);
    packs.get(file).push(row);
  }
  for (const list of packs.values()) {
    list.sort((a, b) => String(a.login).localeCompare(String(b.login)));
  }
  return packs;
}

function inferAssignmentSource(groupNames, appScope) {
  if (appScope === 'USER') return 'individual';
  if (appScope === 'GROUP') return 'group';
  if (groupNames.includes('APP-Rostr-Users') || groupNames.includes('APP-Rostr-Admins')) return 'group';
  return 'none';
}

function lastSignInFromEvents(events, appIds) {
  const wanted = new Set(appIds);
  const latest = new Map();
  for (const event of events) {
    if (event.eventType !== 'user.authentication.sso') continue;
    const targets = Array.isArray(event.target) ? event.target : [];
    if (!targets.some((target) => wanted.has(target.id))) continue;
    const login = String(event.actor?.alternateId || '').toLowerCase();
    if (!login) continue;
    const published = event.published || '';
    const previous = latest.get(login);
    if (!previous || published > previous) latest.set(login, published);
  }
  return latest;
}

function sinceIso(now = new Date(), days = LOOKBACK_DAYS) {
  return new Date(now.getTime() - days * 24 * 60 * 60 * 1000).toISOString();
}

function nextLink(header) {
  return entitlements.nextLink(header);
}

async function getJson(client, url) {
  const response = await client.get(url);
  if (response.status === 404) return { body: null, status: 404, next: null };
  if (!response.ok) {
    const error = new Error(`HTTP ${response.status} for ${url.split('?')[0]}`);
    error.status = response.status;
    throw error;
  }
  const body = await response.json();
  return { body, status: response.status, next: nextLink(response.headers.get('link')) };
}

async function getAll(client, url) {
  const rows = [];
  let page = url;
  while (page) {
    const { body, next } = await getJson(client, page);
    if (!Array.isArray(body)) throw new Error(`Expected a list from ${url.split('?')[0]}`);
    rows.push(...body);
    page = next;
  }
  return rows;
}

function indexEmployees(list) {
  const byId = new Map();
  const byEmail = new Map();
  for (const employee of list) {
    byId.set(employee.employeeId, employee);
    if (employee.email) byEmail.set(String(employee.email).toLowerCase(), employee);
  }
  return { byId, byEmail };
}

function loginOf(user) {
  return String(user.email || user.userName || '').trim();
}

function buildRows({ rostrUsers, employees, oktaByLogin, lastSignIn }) {
  const { byId, byEmail } = indexEmployees(employees);
  const rows = [];
  for (const user of rostrUsers) {
    const login = loginOf(user);
    const key = login.toLowerCase();
    const hr = byEmail.get(key);
    const okta = oktaByLogin.get(key) || { groups: [], assignmentSource: 'none' };
    const pack = packKey(hr);
    rows.push({
      login,
      department: user.department || hr?.department || '',
      manager: pack === 'managed' ? managerEmail(hr, byId) : '',
      groups: okta.groups.join('|'),
      assignmentSource: okta.assignmentSource,
      lastRostrSignIn: lastSignIn.get(key) || '',
      decision: '',
      pack,
    });
  }
  rows.sort((a, b) => a.login.localeCompare(b.login));
  return rows;
}

function readReviewed(dir) {
  if (!fs.existsSync(dir)) throw new Error(`Missing ${dir}`);
  const files = fs.readdirSync(dir).filter((name) => name.endsWith('.csv') && name !== 'revocation.csv').sort();
  if (!files.length) throw new Error(`No CSV files in ${dir}`);
  const rows = [];
  const seen = new Set();
  for (const file of files) {
    const parsed = parseCsv(fs.readFileSync(path.join(dir, file), 'utf8'));
    for (const row of parsed) {
      const login = String(row.login || '').trim();
      if (!login) throw new Error(`${file} has a row with no login`);
      const key = login.toLowerCase();
      if (seen.has(key)) throw new Error(`Duplicate login ${login}`);
      seen.add(key);
      rows.push({
        ...row,
        login,
        decision: parseDecision(row.decision, login),
        file,
      });
    }
  }
  return rows;
}

function formatPlan(ticket, mode, rows) {
  const lines = [`ticket ${ticket}`, `mode ${mode}`];
  const revokes = rows.filter((row) => row.decision === 'Revoke');
  const keeps = rows.filter((row) => row.decision === 'Keep');
  if (!revokes.length) lines.push('no revokes');
  for (const row of revokes) lines.push(`revoke ${row.login}`);
  lines.push(`${keeps.length} keep`);
  lines.push(`${revokes.length} revoke`);
  return lines.join('\n');
}

async function lookupOkta(client, login) {
  const filter = `profile.login eq "${String(login).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
  const found = await getAll(client, `/api/v1/users?filter=${encodeURIComponent(filter)}&limit=2`);
  const user = found[0];
  if (!user) return null;
  const groups = await getAll(client, `/api/v1/users/${user.id}/groups`);
  const names = groups.map((group) => group.profile.name).sort((a, b) => a.localeCompare(b));
  let appScope;
  try {
    const assignment = await getJson(client, `/api/v1/apps/${ROSTR_SAML_APP_ID}/users/${user.id}`);
    appScope = assignment.body?.scope;
  } catch (error) {
    if (error.status !== 403) throw error;
  }
  return {
    id: user.id,
    status: user.status,
    groups: names,
    assignmentSource: inferAssignmentSource(names, appScope),
  };
}

async function collectOkta(client, logins) {
  const oktaByLogin = new Map();
  for (const login of logins) {
    const record = await lookupOkta(client, login);
    if (record) oktaByLogin.set(login.toLowerCase(), record);
  }
  return oktaByLogin;
}

async function collectSignIns(client, now) {
  const filter = 'eventType eq "user.authentication.sso"';
  const url = `/api/v1/logs?filter=${encodeURIComponent(filter)}&since=${encodeURIComponent(sinceIso(now))}&limit=1000&sortOrder=DESCENDING`;
  const events = await getAll(client, url);
  return lastSignInFromEvents(events, [ROSTR_SAML_APP_ID, ROSTR_OIDC_APP_ID]);
}

function defaultListRostrUsers(root) {
  const dbPath = path.join(root, 'rostr', 'data', 'rostr.sqlite');
  if (!fs.existsSync(dbPath)) throw new Error(`Missing ${dbPath}`);
  const { openDatabase, listUsers } = require(path.join(root, 'rostr', 'src', 'db'));
  return listUsers(openDatabase(dbPath));
}

function defaultListEmployees(root) {
  return JSON.parse(fs.readFileSync(path.join(root, 'hr', 'employees.json'), 'utf8'));
}

async function groupIdsByName(client) {
  const groups = await getAll(client, '/api/v1/groups?limit=200');
  const ids = new Map();
  for (const group of groups) {
    ids.set(group.profile.name, group.id);
  }
  for (const name of REVOKE_GROUPS) {
    if (!ids.has(name)) throw new Error(`Missing Okta group ${name}`);
  }
  return ids;
}

async function applyRevokes(client, rows, ticket, admin, now, apply) {
  const logRows = [];
  const ids = apply ? await groupIdsByName(client) : new Map();
  for (const row of rows) {
    if (row.decision !== 'Revoke') continue;
    const okta = await lookupOkta(client, row.login);
    if (!okta) {
      throw new Error(`Revoke ${row.login}: no Okta user`);
    }
    const present = REVOKE_GROUPS.filter((name) => okta.groups.includes(name));
    if (!present.length) {
      logRows.push({
        time: now,
        ticket,
        login: row.login,
        group: '',
        http: 'none',
        admin,
      });
      continue;
    }
    for (const name of present) {
      let http = 'dry-run';
      if (apply) {
        const response = await client.del(`/api/v1/groups/${ids.get(name)}/users/${okta.id}`);
        http = String(response.status);
        if (response.status !== 204 && response.status !== 404) {
          throw new Error(`Revoke ${row.login} ${name} returned HTTP ${response.status}`);
        }
      }
      logRows.push({
        time: now,
        ticket,
        login: row.login,
        group: name,
        http,
        admin,
      });
    }
  }
  return logRows;
}

function writeRevocationLog(file, rows) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const lines = ['time,ticket,login,group,http,admin'];
  for (const row of rows) {
    lines.push(['time', 'ticket', 'login', 'group', 'http', 'admin'].map((key) => csvCell(row[key])).join(','));
  }
  fs.writeFileSync(file, `${lines.join('\n')}\n`);
}

function appendLogsCsv(file, rows) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const headerNeeded = !fs.existsSync(file) || fs.statSync(file).size === 0;
  const lines = [];
  if (headerNeeded) lines.push('time,ticket,login,group,http,admin');
  for (const row of rows) {
    lines.push(['time', 'ticket', 'login', 'group', 'http', 'admin'].map((key) => csvCell(row[key])).join(','));
  }
  fs.appendFileSync(file, `${lines.join('\n')}\n`);
}

async function connectOkta(root, fetchImpl) {
  loadEnvFile(path.join(root, '.env'));
  const org = (process.env.OKTA_ORG_URL || '').replace(/\/$/, '');
  if (!org) throw new Error('Missing OKTA_ORG_URL');
  const keyPath = process.env.OKTA_PRIVATE_KEY_PATH;
  if (!keyPath) throw new Error('Missing OKTA_PRIVATE_KEY_PATH');
  const privateKey = crypto.createPrivateKey(fs.readFileSync(keyPath));
  const { token, nonce } = await entitlements.accessToken(org, privateKey, fetchImpl);
  return entitlements.oktaClient({ org, token, privateKey, nonce, fetchImpl });
}

async function main(argv, io = {}) {
  const stdout = io.stdout || ((line) => console.log(line));
  const cwd = io.cwd || process.cwd();
  const fetchImpl = io.fetchImpl || fetch;
  const now = io.now || new Date();
  const args = parseArgs(argv);
  const root = path.resolve(cwd);
  if (args.command === 'export') {
    const client = io.client || await connectOkta(root, fetchImpl);
    const rostrUsers = io.listRostrUsers ? io.listRostrUsers() : defaultListRostrUsers(root);
    const employees = io.listEmployees ? io.listEmployees() : defaultListEmployees(root);
    const logins = [...new Set(rostrUsers.map(loginOf).filter(Boolean))];
    const oktaByLogin = io.oktaByLogin || await collectOkta(client, logins);
    const lastSignIn = io.lastSignIn || await collectSignIns(client, now);
    const rows = buildRows({ rostrUsers, employees, oktaByLogin, lastSignIn });
    const dir = path.resolve(root, args.out);
    fs.mkdirSync(dir, { recursive: true });
    const packs = splitByManager(rows);
    for (const [file, list] of packs) {
      fs.writeFileSync(path.join(dir, file), toCsv(list));
    }
    stdout(`${rows.length} rows -> ${path.relative(root, dir)} (${packs.size} files)`);
    return 0;
  }
  const dir = path.resolve(root, args.in);
  const rows = readReviewed(dir);
  stdout(formatPlan(args.ticket, args.apply ? 'apply' : 'dry-run', rows));
  const client = io.client || await connectOkta(root, fetchImpl);
  const admin = process.env.JML_ADMIN || os.userInfo().username;
  const stamp = now.toISOString();
  const logRows = await applyRevokes(client, rows, args.ticket, admin, stamp, args.apply);
  if (!args.apply) {
    stdout(logRows.map((row) => `${row.login} ${row.group || '(no APP-Rostr group)'} ${row.http}`).join('\n'));
    return 0;
  }
  writeRevocationLog(path.join(dir, 'revocation.csv'), logRows);
  appendLogsCsv(path.join(root, 'logs', 'access-review.csv'), logRows);
  stdout(`revoked ${logRows.length} group rows -> ${path.relative(root, path.join(dir, 'revocation.csv'))}`);
  return 0;
}

if (require.main === module) {
  main(process.argv.slice(2)).then(
    (code) => process.exit(code),
    (error) => {
      console.error(error.message);
      process.exit(1);
    },
  );
}

module.exports = {
  HEADER,
  REVOKE_GROUPS,
  ROSTR_SAML_APP_ID,
  ROSTR_OIDC_APP_ID,
  parseArgs,
  parseTicket,
  parseCsv,
  parseDecision,
  toCsv,
  buildRows,
  splitByManager,
  fileForRow,
  inferAssignmentSource,
  lastSignInFromEvents,
  sinceIso,
  formatPlan,
  readReviewed,
  applyRevokes,
  main,
};
